        <!-- KELAS 1: MesinKendaraan (Komposisi) -->
        <mxCell id="class_mesin" value="&lt;p style=&quot;margin:0px;padding:4px;text-align:center;&quot;&gt;&lt;b&gt;MesinKendaraan&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:11px;&quot;&gt;&amp;lt;&amp;lt;component&amp;gt;&amp;gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- nomorSeriMesin: string&lt;br/&gt;- tipeMesin: string&lt;br/&gt;- jenisBahanBakar: string&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ MesinKendaraan()&lt;br/&gt;+ MesinKendaraan(seri, tipe, bbm)&lt;br/&gt;+ getNomorSeriMesin(): string&lt;br/&gt;+ getTipeMesin(): string&lt;br/&gt;+ getJenisBahanBakar(): string&lt;br/&gt;+ setNomorSeriMesin(seri: string): void&lt;br/&gt;+ setTipeMesin(tipe: string): void&lt;br/&gt;+ setJenisBahanBakar(bbm: string): void&lt;br/&gt;+ ~MesinKendaraan()&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;valign=top;strokeColor=#495057;fillColor=#F8F9FA;rounded=1;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="310" height="250" as="geometry" />
        </mxCell>

        <!-- KELAS 2: KendaraanPengiriman (Kelas Induk / Base Class) -->
