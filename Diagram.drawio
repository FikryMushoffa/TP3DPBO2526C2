        <!-- TITLE BANNER -->
        <mxCell id="title_banner" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;DIAGRAM KELAS SISTEM LOGISTIK MULTIMODA (TP3 DPBO)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt;Pewarisan Hirarki (Hierarchical Inheritance), Komposisi, Agregasi, Asosiasi, Polimorfisme &amp; Array of Objects&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fillColor=#212529;fontColor=#FFFFFF;strokeColor=none;shadow=1;" vertex="1" parent="1">
