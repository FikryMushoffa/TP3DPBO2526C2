        <mxCell id="class_pesawat" value="&lt;p style=&quot;margin:0px;padding:4px;text-align:center;&quot;&gt;&lt;b&gt;PesawatKargo&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:11px;&quot;&gt;&amp;lt;&amp;lt;derived - udara&amp;gt;&amp;gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- ketinggianMaksimal: int&lt;br/&gt;- surchargeAvtur: double&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ PesawatKargo()&lt;br/&gt;+ PesawatKargo(id, merk, mesin, alt, sur)&lt;br/&gt;+ getKetinggianMaksimal(): int&lt;br/&gt;+ getSurchargeAvtur(): double&lt;br/&gt;+ setKetinggianMaksimal(alt: int): void&lt;br/&gt;+ setSurchargeAvtur(sur: double): void&lt;br/&gt;+ tampilkanSpesifikasi(): void&lt;br/&gt;+ ~PesawatKargo()&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;valign=top;strokeColor=#7950F2;fillColor=#F3F0FF;rounded=1;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
