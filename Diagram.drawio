        <!-- KELAS 8: DepoLogistik (Agregasi & Array of Objects) -->
        <mxCell id="class_depo" value="&lt;p style=&quot;margin:0px;padding:4px;text-align:center;&quot;&gt;&lt;b&gt;DepoLogistik&lt;/b&gt;&lt;br/&gt;&lt;i style=&quot;font-size:11px;&quot;&gt;&amp;lt;&amp;lt;hub manager - agregasi&amp;gt;&amp;gt;&lt;/i&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;- kodeDepo: string&lt;br/&gt;- kotaLokasi: string&lt;br/&gt;- daftarTruk: vector&amp;lt;TrukKargo*&amp;gt;&lt;br/&gt;- daftarKapal: vector&amp;lt;KapalLaut*&amp;gt;&lt;br/&gt;- daftarPesawat: vector&amp;lt;PesawatKargo*&amp;gt;&lt;br/&gt;- daftarPaket: vector&amp;lt;Paket*&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ DepoLogistik()&lt;br/&gt;+ DepoLogistik(kodeDepo, kotaLokasi)&lt;br/&gt;+ getKodeDepo(): string&lt;br/&gt;+ getKotaLokasi(): string&lt;br/&gt;+ getDaftarTruk(): vector&amp;lt;TrukKargo*&amp;gt;&lt;br/&gt;+ getDaftarKapal(): vector&amp;lt;KapalLaut*&amp;gt;&lt;br/&gt;+ getDaftarPesawat(): vector&amp;lt;PesawatKargo*&amp;gt;&lt;br/&gt;+ getDaftarPaket(): vector&amp;lt;Paket*&amp;gt;&lt;br/&gt;+ setKodeDepo(kode: string): void&lt;br/&gt;+ setKotaLokasi(kota: string): void&lt;br/&gt;+ setDaftarTruk(daftar: vector): void&lt;br/&gt;+ setDaftarKapal(daftar: vector): void&lt;br/&gt;+ setDaftarPesawat(daftar: vector): void&lt;br/&gt;+ setDaftarPaket(daftar: vector): void&lt;br/&gt;+ tambahTruk(truk: TrukKargo*): void&lt;br/&gt;+ tambahKapal(kapal: KapalLaut*): void&lt;br/&gt;+ tambahPesawat(pesawat: PesawatKargo*): void&lt;br/&gt;+ tambahPaket(paket: Paket*): void&lt;br/&gt;+ tampilkanInformasiDepo(): void&lt;br/&gt;+ ~DepoLogistik()&lt;/p&gt;" style="html=1;whiteSpace=wrap;align=left;valign=top;strokeColor=#E03131;fillColor=#FFF5F5;rounded=1;shadow=1;fontFamily=Helvetica;" vertex="1" parent="1">
